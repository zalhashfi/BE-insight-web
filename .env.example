PORT=3000
NODE_ENV=development

# Database Configuration — VPS/Node saja.
# Cloudflare Worker TIDAK memakai variabel DB_* ini; koneksi DB lewat Hyperdrive binding.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=insight_web_db
DB_PORT=3306

# Security & Secrets (VPS/Node via .env; Cloudflare via wrangler secret put)
JWT_SECRET=super_secret_jwt_key_change_in_production
IOT_DEVICE_SECRET=iot_device_shared_secret_key

# Cloudflare (utama):
# - Buat Hyperdrive ke MySQL, catat id-nya ke wrangler.toml [[hyperdrive]] id
# - wrangler secret put JWT_SECRET
# - wrangler secret put IOT_DEVICE_SECRET
# (Gunakan JWT_SECRET produksi yang sama agar token lama tetap valid.)

# Initial admin seed (used only by `npm run db:init`; leave unset for no seed)
# Self-registration always creates a viewer — admins are created here, not via the API.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
