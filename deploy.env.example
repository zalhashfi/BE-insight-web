# Template secret untuk docker-compose staging di VPS.
# JANGAN isi file ini — salin lalu isi:
#   cp deploy.env.example .env
# docker compose membaca .env dari folder yang sama dengan docker-compose.yml
# (repo BE). File .env sudah di-gitignore, tidak akan pernah ter-push.
# Generate nilai: openssl rand -base64 32

MYSQL_ROOT_PASSWORD=changeme-generate-baru
DB_PASSWORD=changeme-generate-baru
JWT_SECRET=changeme-generate-baru
IOT_DEVICE_SECRET=changeme-generate-baru
