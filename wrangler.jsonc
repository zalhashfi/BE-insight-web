{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "957e0d69b0f14a6592208df23d829cf6",
			"localConnectionString": "postgresql://user:pass@localhost:5432/postgres"
		}
	],

	"kv_namespaces": [
		{
			"binding": "RATE_LIMITER",
			"id": "1bb63666623f4f3aad3a6d1314028b96"
		}
	],
